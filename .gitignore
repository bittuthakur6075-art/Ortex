# Dependencies & build output
node_modules
dist
dist-ssr
*.local
.vercel

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets (keep the committed *.example templates)
.env
.env.*
!.env.example
!.env.*.example

# Supabase CLI local state
**/supabase/.temp/

# Tally connector runtime files
Ortex.Tally.Connector/config.json
Ortex.Tally.Connector/out

# Build archives / screenshots must never be committed
*.zip
*.tgz

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Deno lockfile generated by ad-hoc `deno check` runs (functions deploy without it)
deno.lock

# Supabase CLI link state (project_id differs per staging/production checkout)
Ortex.Admin/supabase/config.toml

# Database backups written by Ortex.Admin/scripts/backup.mjs — real business
# data, never committed.
backups/
