# ── DEVELOPMENT environment (local only) ──────────────────────────────────
# Loaded by:  npm run dev   (mode development)
# Copy to `.env.development` and point it at the DEVELOPMENT Supabase project —
# the one that may hold throwaway/demo records. Never the production project.
#
# This project is SHARED WITH STAGING (see .env.staging.example): both are
# non-production, so they use one database and one set of Edge Function secrets.
# Production is the only environment with a database of its own.
VITE_SUPABASE_URL=https://YOUR-DEV-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-public-key

# Shown as a badge in the Admin so dev is never mistaken for production.
VITE_ENV_LABEL=Development

# Optional: leave blank locally so saving a product doesn't trigger a real
# marketing-site rebuild.
VITE_DEPLOY_HOOK_URL=

# Reminder: Edge Function secrets are per Supabase project, so the shared
# dev/staging project needs its own:
#   supabase secrets set GEMINI_API_KEY=... --project-ref YOUR-DEV-ref
