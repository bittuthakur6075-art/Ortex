{
  "name": "ortex-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ortex Industries — business operations admin console (Enquiries, Products, Quotations, Invoicing, Payments).",
  "scripts": {
    "dev": "vite --mode development",
    "dev:staging": "vite --mode staging",
    "build": "node scripts/check-env.mjs production && vite build --mode production",
    "build:staging": "node scripts/check-env.mjs staging && vite build --mode staging",
    "build:production": "node scripts/check-env.mjs production && vite build --mode production",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "check:functions": "npx --yes deno@2 check supabase/functions/*/index.ts supabase/functions/_shared/*.ts",
    "check:env": "node scripts/check-env.mjs production",
    "provision": "node scripts/provision-supabase.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:schedule": "powershell -ExecutionPolicy Bypass -File scripts/schedule-backup.ps1",
    "push:emails": "node scripts/push-email-templates.mjs",
    "sb": "supabase",
    "sb:status": "supabase projects list",
    "sb:fn:list": "supabase functions list",
    "sb:fn:deploy": "supabase functions deploy",
    "sb:db:push": "supabase db push",
    "sb:db:diff": "supabase db diff --linked",
    "sb:secrets": "supabase secrets list",
    "sb:provision": "node scripts/provision-supabase.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.110.0",
    "apexcharts": "^5.16.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "html2pdf.js": "^0.14.0",
    "iconsax-react": "^0.0.8",
    "react": "^19.2.7",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.117.0-beta.21",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
