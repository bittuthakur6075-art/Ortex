# ── STAGING (Vercel) ──────────────────────────────────────────────────────
# Loaded by: npm run dev:staging / npm run build:staging
#
# Empty by default, exactly like development: a local staging build runs on
# localStorage demo data rather than any real database.
#
# On Vercel these values come from the project's Environment Variables, which
# override this file. Two valid choices there:
#
#   1. Leave VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY unset. The staging
#      deploy then runs on demo data — safe for reviewing screens and flows.
#   2. Point them at a SECOND Supabase project, provisioned with
#      `npm run provision -- <ref>`, when reviewers need shared persistent data.
#
# Never point them at the production project. Staging writes would land in the
# live invoice and payment records.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_ENV_LABEL=Staging

# Optional: deploy hook for a staging marketing site (leave blank to disable).
VITE_DEPLOY_HOOK_URL=
