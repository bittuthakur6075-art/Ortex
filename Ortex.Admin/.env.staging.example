# ── STAGING environment (hosted on Vercel) ────────────────────────────────
# Loaded by:  npm run dev:staging   and   npm run build:staging
# Copy to `.env.staging` for local staging builds. On Vercel, DO NOT commit this
# file — set the same VITE_ vars in the Vercel project's Environment Variables
# (they are injected at build time and override any file here).
#
# STAGING DELIBERATELY SHARES THE DEVELOPMENT SUPABASE PROJECT. Both are
# non-production, so one database keeps the schema, seed data and Edge Function
# secrets in a single place: what you test locally is exactly what reviewers see
# on the Vercel deploy, with no second project to keep in sync.
#
# Use the SAME values as .env.development here. The only difference is the badge.
# Never point this at the production project.
VITE_SUPABASE_URL=https://YOUR-DEV-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-public-key

# Shown as a badge in the Admin so staging is never mistaken for production.
VITE_ENV_LABEL=Staging

# Optional: deploy hook for the STAGING marketing site (leave blank to disable).
VITE_DEPLOY_HOOK_URL=

# Reminder: Edge Function secrets live on the shared dev/staging project, so
# they only need setting once:
#   supabase secrets set GEMINI_API_KEY=... --project-ref YOUR-DEV-ref
