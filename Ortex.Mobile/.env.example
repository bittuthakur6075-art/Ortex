# Supabase — copy to `.env` and fill from the SAME project Ortex.Admin points at.
# Both values are safe on a device (the anon key is public; RLS enforces access),
# and staff still have to sign in with a real account before anything loads.
#
# Use the development/staging project while building; only a release build for
# the sales team should carry the production project's values.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
