# Ortex marketing site — Apache config for static hosting (e.g. Hostinger).
# Vite copies public/ into dist/, so this ships with every build. Upload the
# CONTENTS of dist/ into public_html.

# ----------------------------------------------------------------------
# Routing for a PRERENDERED site (scripts/prerender.mjs writes one
# <route>/index.html per page, plus 404.html). Every public URL is a real file,
# so there is no catch-all to index.html: an unknown URL answers a genuine 404
# instead of "200 OK" with an empty app, which Google reads as a soft 404 and
# which kept an old "Ortex Medical" page of this domain indexed.
#
# One canonical form per page: https://bizgift.ortexindustries.in/<path>, no
# trailing slash, no index.html. Everything else 301s to it in one hop.
# ----------------------------------------------------------------------
Options -MultiViews -Indexes
DirectoryIndex index.html
# Without this Apache 301s /about to /about/ before any rule below runs, which
# contradicts the canonical tag on every page.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www.bizgift... moves to the one canonical host. HTTPS itself is forced by
  # hPanel's "Force HTTPS" toggle, which avoids a redirect loop behind
  # Hostinger's CDN.
  # A trailing slash is dropped in the same hop, so www.../about/ reaches
  # /about in one redirect, not two.
  RewriteCond %{HTTP_HOST} ^www\.bizgift\.ortexindustries\.in$ [NC]
  RewriteRule ^(.+?)/+$ https://bizgift.ortexindustries.in/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.bizgift\.ortexindustries\.in$ [NC]
  RewriteRule ^ https://bizgift.ortexindustries.in%{REQUEST_URI} [R=301,L]

  # Paths from earlier versions of the site.
  RewriteRule ^(portfolio|photos|gallery)/?$ /work [R=301,L]
  # A dental product page from a previous owner of the domain, still in
  # Google's index: 410 Gone tells Google to drop it faster than a 404.
  RewriteRule ^beautifil-injectable-22g/?$ - [G,L]

  # /index.html and /about/index.html are the same pages as / and /about.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/(.+)/index\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # /about/ becomes /about. Every URL, not only prerendered folders: a product
  # added since the last build has no folder yet, and its /slash/ form must
  # reach the address the app and the canonical use (an unknown URL still
  # 404s, one hop later).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # Serve /about from about/index.html without changing the URL.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# The prerendered not-found page. It still boots the app, so a product added in
# the console after the last build renders for a visitor while telling crawlers
# it is not a page yet (rebuild and upload to index it).
ErrorDocument 404 /404.html
# A missing /assets file (a chunk from an older build, asked for by a tab
# opened before a deploy) gets a bare 404 instead, from assets/.htaccess, so
# the import fails fast and the app reloads onto the current build
# (src/lib/lazyWithRetry.js).

# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json
  AddOutputFilterByType DEFLATE application/javascript application/xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Caching: content-hashed assets are immutable (cache a year); HTML must
# revalidate so deploys show up immediately.
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Files outside /assets keep their names across deploys (the mic worklet,
  # /img, icons), so they are cached for a day, not for ever. The hashed files
  # in /assets are immutable: assets/.htaccess gives them a year.
  <FilesMatch "\.(css|js|woff2|png|jpe?g|webp|avif|svg|gif)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Always revalidate HTML so new deploys are picked up
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Baseline security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS only from now on (hPanel's Force HTTPS does the first redirect).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # The voice assistant needs the microphone on this origin; nothing else
  # needs a device.
  Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=()"
  # Keep in step with vercel.json. Every <script> the prerender writes is
  # either an external file from /assets or a non-executable JSON block, so
  # script-src needs no 'unsafe-inline'. connect-src: Supabase (REST, storage,
  # realtime), Gemini Live (the voice assistant), the two consent-gated IP
  # lookups. frame-src: the Google Maps embed on /contact. The mic worklet is a
  # static file on 'self'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com https://ipapi.co https://ipwho.is; frame-src https://www.google.com https://consent.google.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Serve the correct MIME type for source maps / json if needed
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

