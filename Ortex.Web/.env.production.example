# ── PRODUCTION environment (the live marketing site) ──────────────────────
# Loaded by:  npm run build
# Copy to `.env.production` on the machine that builds the public site and fill
# in the PRODUCTION Supabase project's values.
#
# These are read twice: in the browser (catalogue reads + lead capture) and at
# BUILD time by scripts/prerender.mjs, which bakes the live catalogue into the
# static HTML for SEO. Building with dev values would publish dev products.
VITE_SUPABASE_URL=https://YOUR-PRODUCTION-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-public-key

# Google Search Console, URL-prefix property https://bizgift.ortexindustries.in/
# (Settings → Ownership verification → HTML tag). Paste the content="…" code or
# the whole <meta> tag; scripts/prerender.mjs writes it into every page. Keep it
# set for good: removing it un-verifies the property at Google's next check.
GOOGLE_SITE_VERIFICATION=
