# PRODUCTION values for `npm run build` (scripts/check-env.mjs refuses to build
# without them). Same Supabase URL and anon key as Ortex.Web and the Admin.
VITE_SUPABASE_URL=https://YOUR-PRODUCTION-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-public-key

# Google Search Console, URL-prefix property https://ortexindustries.in/
# (HTML tag method). Paste the content="..." code or the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile site key (public) for the voice assistant bot check.
# Leave empty to switch the check off. The secret goes to Supabase:
#   npx.cmd supabase secrets set TURNSTILE_SECRET=...
VITE_TURNSTILE_SITE_KEY=
