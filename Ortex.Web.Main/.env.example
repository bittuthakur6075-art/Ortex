# Copy to .env.development / .env.production and fill from the Supabase project
# (Settings -> API). There is ONE Supabase project and it is production (root
# CLAUDE.md): the contact form inserts real rows into `enquiries`, which the
# Admin console shows as new leads. The anon key is safe in the browser; RLS
# lets it INSERT an enquiry and nothing else.
#
# Without these the site still runs: the contact form keeps the enquiry in the
# visitor's browser outbox and tells them to WhatsApp instead (src/lib/leads.js).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
